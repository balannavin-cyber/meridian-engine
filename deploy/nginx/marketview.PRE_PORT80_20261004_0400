# MERDIAN Marketview — static SPA served on :8080
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    root /var/www/marketview;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires off;
    }

    location = /_health {
        default_type application/json;
        return 200 '{"status":"ok","service":"marketview-nginx"}';
    }

    access_log /var/log/nginx/marketview.access.log;
    error_log  /var/log/nginx/marketview.error.log;
}

server {
    server_name marketview.meridianalpha.in; # managed by Certbot
    root /var/www/marketview;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires off;
    }

    location = /_health {
        default_type application/json;
        return 200 '{"status":"ok","service":"marketview-nginx"}';
    }

    access_log /var/log/nginx/marketview.access.log;
    error_log  /var/log/nginx/marketview.error.log;


    auth_request /oauth2/auth;
    error_page 401 = /oauth2/sign_in;
    auth_request_set $email $upstream_http_x_auth_request_email;
    location = /oauth2/auth {
        auth_request off; internal;
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }
    location /oauth2/ {
        auth_request off;
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/marketview.meridianalpha.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/marketview.meridianalpha.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = marketview.meridianalpha.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 ;
    listen [::]:80 ;
    server_name marketview.meridianalpha.in;
    return 404; # managed by Certbot


}