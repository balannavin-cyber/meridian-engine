# Starts tape-runner.service at 08:50 IST on weekdays. Persistent: a missed start (box down at
# 08:50) fires at boot; the runner itself decides what is due (after 15:40 it only re-ships the spool).
[Unit]
Description=MERIDIAN tape raw recorder (T0) -- weekday 08:50 IST

[Timer]
OnCalendar=Mon..Fri *-*-* 08:50:00 Asia/Kolkata
Persistent=true
Unit=tape-runner.service

[Install]
WantedBy=timers.target
